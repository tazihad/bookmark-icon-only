{
  "manifest_version": 3,
  "name": "Bookmark Icon Only",
  "version": "1.0.2",
  "description": "Show selected bookmarks as icons only with Microsoft Edge-like toggle and resilient storage",
  "permissions": [
    "bookmarks",
    "storage",
    "menus"
  ],
  "background": {
    "scripts": ["db.js", "background.js"]
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-icon-only@zihad.com.bd",
      "strict_min_version": "140.0"
    }
  }
}
